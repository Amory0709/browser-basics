{
  "name": "@browser-basics/yjs-room",
  "version": "0.1.0",
  "description": "Yjs room sync with hidden presenter permissions and viewport follow controls",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "import": "./server/index.js"
    }
  },
  "files": [
    "dist",
    "server",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "~6.0.2"
  }
}

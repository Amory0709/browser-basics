{
  "name": "@browser-basics/embed-sdk",
  "version": "0.1.0",
  "description": "postMessage bridge between course embeds and the collab shell",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
